{
  "name": "saqi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "design:check": "pnpm --filter @saqi/tokens build",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc -p scripts",
    "test": "pnpm -r test",
    "test:ci": "pnpm -r run test --reporter=default --reporter=json --outputFile=.vitest/results.json",
    "format": "prettier --write .",
    "e2e": "pnpm --filter web e2e",
    "e2e:ui": "pnpm --filter web e2e:ui",
    "e2e:docker": "pnpm --filter web e2e:docker",
    "stats": "node scripts/test-stats.ts",
    "smoke": "node --import ./scripts/resolve-ts.ts scripts/smoke.ts",
    "og": "pnpm --filter web og"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@saqi/shared": "workspace:^",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
