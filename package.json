{
  "name": "saqi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "design:check": "pnpm --filter @saqi/tokens build",
